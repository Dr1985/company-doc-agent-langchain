# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"
# 千问的embedding模型
QWEN_EMBEDDING_API_KEY="12345678"
QWEN_EMBEDDING_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_EMBEDDING_DIMS=1024
# Langfuse Settings
# Langfuse is an open-source LLM observability platform.
# Get your credentials at: https://cloud.langfuse.com or self-host
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: Enable/disable tracing (default: enabled if credentials are set)
LANGFUSE_TRACING_ENABLED=true

# Optional: Debug mode for verbose logging (default: follows DEBUG setting)
# LANGFUSE_DEBUG=false

# Optional: Sample rate for traces (0.0 to 1.0, default: 1.0 = 100%)
# LANGFUSE_SAMPLE_RATE=1.0

# Optional: Release version for tracking deployments
# LANGFUSE_RELEASE=1.0.0

# Optional: Flush settings for batch processing
# LANGFUSE_FLUSH_AT=10
# LANGFUSE_FLUSH_INTERVAL=0.5

# LLM Settings
# Leave LLM_PROVIDER=auto to resolve the provider during startup.
# Auto mode prefers the provider implied by DEFAULT_LLM_MODEL when possible,
# otherwise it uses the only configured key, or falls back by provider priority
# (OpenAI -> OpenRouter -> DeepSeek) when multiple keys exist.
LLM_PROVIDER=auto
OPENAI_API_KEY=""
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenRouter free model examples:
# DEFAULT_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# DEFAULT_LLM_MODEL=openai/gpt-oss-120b:free
# DEFAULT_LLM_MODEL=z-ai/glm-4.5-air:free
DEFAULT_LLM_MODEL=
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3

# Long-Term Memory Settings
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_PROVIDER=auto
LONG_TERM_MEMORY_MODEL=
# Optional: keep an OpenAI-compatible embedding provider if you want mem0
# long-term memory while using DeepSeek for chat generation.
LONG_TERM_MEMORY_EMBEDDER_PROVIDER=
LONG_TERM_MEMORY_EMBEDDER_API_KEY=""
LONG_TERM_MEMORY_EMBEDDER_BASE_URL=https://api.openai.com/v1
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_EMBEDDER_DIMS=1536
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory

# MinIO / S3 Configuration (Phase 2: Document Ingestion)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false

# Ingestion Configuration (Phase 2: Document Chunking)
INGESTION_CHUNK_SIZE=512
INGESTION_CHUNK_OVERLAP=128
MAX_UPLOAD_SIZE=52428800

# Optional evaluation overrides (defaults to the active chat provider if unset)
EVALUATION_LLM=
EVALUATION_BASE_URL=
EVALUATION_API_KEY=""

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# Redis (热点问答缓存)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL=86400
REDIS_CACHE_SIMILARITY_THRESHOLD=0.95
